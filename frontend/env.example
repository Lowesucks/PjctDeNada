# Configuración de Google Maps
# Copia este archivo a .env y reemplaza TU_API_KEY_AQUI con tu clave real

# API Key de Google Maps (obtener en https://console.cloud.google.com/)
REACT_APP_GOOGLE_MAPS_API_KEY=TU_API_KEY_AQUI

# Configuración HTTPS (opcional)
HTTPS=false

# Puerto del servidor de desarrollo (opcional)
PORT=3000 